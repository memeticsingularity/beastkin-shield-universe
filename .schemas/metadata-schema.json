{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://beastkin-universe.github.io/schemas/metadata-schema-bilingual.json",
  "title": "Beastkin Universe Metadata Schema / 兽盾宇宙元数据架构",
  "description": "Schema for validating metadata.yaml files - Compatible with Naming Guide v2.3.0 | 验证 metadata.yaml 文件的架构 - 适配命名指南 v2.3.0",
  "type": "object",
  "required": [
    "work",
    "creation"
  ],
  "properties": {
    "work": {
      "type": "object",
      "required": [
        "code",
        "title",
        "format",
        "form_type",
        "status",
        "location"
      ],
      "description": "Work information section / 作品信息部分",
      "properties": {
        "code": {
          "type": "string",
          "description": "Complete work code, must exactly match folder name - Format: [universe]-[nature]-[form_type]-[natural_number]-[series_name] | 作品完整编码，必须与文件夹名完全一致 - 格式：[世界观]-[性质]-[形式类型]-[自然数序号]-[系列名]",
          "pattern": "^(bs|bsp|bsr|uba)-([oac])-(cm|cs|s)-\\d+(-[a-z0-9-]+)?$",
          "examples": [
            "bsp-o-cs-1-g-277-green-bull-azhuang",
            "bs-o-cm-1-first-volume",
            "bs-a-s-1-first-blood"
          ]
        },
        "title": {
          "type": "object",
          "required": [
            "chinese",
            "english"
          ],
          "description": "Work titles in both languages / 双语作品标题",
          "properties": {
            "chinese": {
              "type": "string",
              "description": "Chinese title of the work / 作品中文标题",
              "minLength": 1
            },
            "english": {
              "type": "string",
              "description": "English title of the work / 作品英文标题",
              "minLength": 1
            }
          }
        },
        "format": {
          "type": "string",
          "enum": [
            "chaptered-story",
            "short-story"
          ],
          "description": "Work format - chaptered-story or short-story | 作品格式 - 分章故事或短篇故事"
        },
        "form_type": {
          "type": "string",
          "enum": [
            "cm",
            "cs",
            "s"
          ],
          "description": "Form type - cm=chaptered main, cs=chaptered side, s=short story | 形式类型 - cm=主线分章, cs=支线分章, s=短篇"
        },
        "subtype": {
          "type": "string",
          "enum": [
            "main",
            "side"
          ],
          "description": "For chaptered stories only: main or side. Automatically determined by form_type: cm→main, cs→side | 仅分章故事需要：主线或支线。根据form_type自动确定：cm→main, cs→side"
        },
        "status": {
          "type": "string",
          "enum": [
            "updating",
            "completed",
            "abandoned"
          ],
          "description": "Work status - updating=in progress, completed=finished, abandoned=no longer worked on | 作品状态 - updating=更新中, completed=已完成, abandoned=已弃置"
        },
        "location": {
          "type": "string",
          "enum": [
            "original-archives",
            "adaptation-works"
          ],
          "description": "Storage location - original-archives=original works, adaptation-works=adaptation works | 存储位置 - original-archives=原创作品, adaptation-works=改编作品"
        },
        "promotion_status": {
          "type": "string",
          "enum": [
            "not_eligible",
            "eligible",
            "under_review",
            "promoted"
          ],
          "description": "Promotion eligibility status | 晋升资格状态",
          "default": "not_eligible"
        },
        "work_type": {
          "type": "string",
          "enum": [
            "full-original",
            "direct-adaptation",
            "adapted-expansion",
            "inspired-by",
            "crossover"
          ],
          "description": "Detailed work type classification | 作品类型细分分类",
          "default": "full-original"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": "Tags for categorization and search - use kebab-case format | 作品标签，便于分类和搜索 - 使用kebab-case格式"
        },
        "inspiration_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "direct-adaptation",
                  "world-element",
                  "character",
                  "scene",
                  "theme"
                ]
              },
              "original_code": {
                "type": "string",
                "pattern": "^(bs|bsp|bsr|uba)-([oac])-(cm|cs|s)-\\d+(-[a-z0-9-]+)?$"
              },
              "reference": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "description": "Inspiration sources for works with multiple inspirations | 灵感来源，用于有多个灵感来源的作品"
        },
        "content_warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": "Content warnings for sensitive material | 内容警告，用于敏感内容"
        },
        "reading_time_estimate": {
          "type": "object",
          "properties": {
            "minutes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "description": "Estimated reading time in minutes | 估计阅读时间（分钟）"
        },
        "target_audience": {
          "type": "string",
          "enum": [
            "general",
            "mature",
            "all-ages"
          ],
          "description": "Intended audience for the work | 作品的目标读者群体",
          "default": "general"
        },
        "series_info": {
          "type": "object",
          "properties": {
            "series_name": {
              "type": "string"
            },
            "position_in_series": {
              "type": "integer",
              "minimum": 1
            },
            "total_in_series": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "description": "Information if work is part of a series | 如果作品属于系列作品，提供系列信息"
        },
        "related_works": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^(bs|bsp|bsr|uba)-([oac])-(cm|cs|s)-\\d+(-[a-z0-9-]+)?$"
              },
              "relation_type": {
                "type": "string",
                "enum": [
                  "prequel",
                  "sequel",
                  "side-story",
                  "same-universe",
                  "crossover"
                ]
              }
            },
            "required": [
              "code",
              "relation_type"
            ],
            "additionalProperties": false
          },
          "description": "Links to related works | 相关作品链接"
        }
      },
      "additionalProperties": false
    },
    "creation": {
      "type": "object",
      "required": [
        "author",
        "start_date"
      ],
      "description": "Creation information section / 创作信息部分",
      "properties": {
        "author": {
          "type": "string",
          "description": "Author name or ID | 作者名称或ID",
          "minLength": 1
        },
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "Start date when work was created - Format: YYYY-MM-DD | 开始创作日期 - 格式：YYYY-MM-DD"
        },
        "last_update": {
          "type": "string",
          "format": "date",
          "description": "Last update date - Format: YYYY-MM-DD | 最后更新日期 - 格式：YYYY-MM-DD"
        },
        "universe_based_on": {
          "type": "string",
          "enum": [
            "beastshield",
            "beastshield-reforged",
            "united-beasts-alliance",
            "beastshield-paradise",
            "mixed"
          ],
          "description": "Which universe this work is based on | 作品基于哪个世界观"
        },
        "adaptation_info": {
          "type": "object",
          "properties": {
            "original_work": {
              "type": "string",
              "pattern": "^(bs|bsp|bsr|uba)-([oac])-(cm|cs|s)-\\d+(-[a-z0-9-]+)?$"
            },
            "original_title": {
              "type": "string"
            },
            "original_author": {
              "type": "string"
            },
            "adaptation_approach": {
              "type": "string",
              "enum": [
                "faithful",
                "reimagined",
                "loose",
                "theme-inversion"
              ]
            },
            "key_changes": {
              "type": "string"
            }
          },
          "required": [
            "original_work",
            "original_title",
            "adaptation_approach",
            "key_changes"
          ],
          "additionalProperties": false,
          "description": "Adaptation information - REQUIRED for adaptation works | 改编信息 - 改编作品必填"
        },
        "collaborators": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "contribution": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "role"
            ],
            "additionalProperties": false
          },
          "description": "Collaborator information for multi-author works | 合作者信息，用于多作者作品"
        },
        "translator": {
          "type": "string",
          "description": "Translator for translated works | 翻译者，用于翻译作品"
        },
        "crossover_info": {
          "type": "object",
          "properties": {
            "universes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "beastshield",
                  "beastshield-reforged",
                  "united-beasts-alliance",
                  "beastshield-paradise"
                ]
              }
            },
            "primary_universe": {
              "type": "string",
              "enum": [
                "beastshield",
                "beastshield-reforged",
                "united-beasts-alliance",
                "beastshield-paradise"
              ]
            }
          },
          "additionalProperties": false,
          "description": "Crossover information for crossover works | 跨界联动信息，用于跨界联动作品"
        },
        "creation_tools": {
          "type": "object",
          "properties": {
            "writing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "editing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "other": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "description": "Tools used in creation process | 创作过程中使用的工具"
        },
        "license": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Licensing information for the work | 作品的许可协议信息"
        },
        "publication": {
          "type": "object",
          "properties": {
            "platforms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "primary_platform": {
              "type": "string"
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "additionalProperties": false,
          "description": "Publication platforms and URLs | 发布平台和URL"
        },
        "revision_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "changes": {
                "type": "string"
              }
            },
            "required": [
              "version",
              "date",
              "changes"
            ],
            "additionalProperties": false
          },
          "description": "Revision history tracking | 修订历史记录"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "work": {
            "properties": {
              "format": {
                "const": "chaptered-story"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "work"
        ],
        "properties": {
          "work": {
            "required": [
              "subtype"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "creation": {
            "properties": {
              "universe_based_on": {
                "const": "mixed"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "creation"
        ],
        "properties": {
          "creation": {
            "required": [
              "crossover_info"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work": {
            "properties": {
              "form_type": {
                "const": "cm"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "work"
        ],
        "properties": {
          "work": {
            "properties": {
              "subtype": {
                "const": "main"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work": {
            "properties": {
              "form_type": {
                "const": "cs"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "work"
        ],
        "properties": {
          "work": {
            "properties": {
              "subtype": {
                "const": "side"
              }
            }
          }
        }
      }
    }
  ]
}